{
    "$schema": "https://getcomposer.org/schema.json",
    "keywords": ["laravel", "developer"],
    "name": "mike-bronner/laravel-development-settings",
    "description": "Shared settings for Laravel development.",
    "type": "composer-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Mike Bronner",
            "email": "mike.bronner@icloud.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "composer-plugin-api": "^2.0",
        "laravel/prompts": "^0.3",
        "mike-bronner/clean-code": "^0.1"
    },
    "require-dev": {
        "laravel/boost": "^2.9",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.0",
        "composer/composer": "^2.0"
    },
    "replace": {
        "mikebronner/development-settings": "self.version"
    },
    "conflict": {
        "laravel/boost": "<2.9"
    },
    "autoload": {
        "psr-4": {
            "MikeBronner\\DevelopmentSettings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MikeBronner\\DevelopmentSettings\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/dev-settings-contribute.php"
    ],
    "scripts": {
        "test": "pest",
        "dev-settings:manifest": "@php bin/generate-manifest.php",
        "dev-settings:contribute": "@php bin/dev-settings-contribute.php"
    },
    "extra": {
        "class": "MikeBronner\\DevelopmentSettings\\ComposerPlugin"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
