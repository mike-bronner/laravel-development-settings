# What Testbench writes when it boots rooted at a package: the artisan shim
# creates these directories on every run, and earlier releases created them
# too. Their contents stay ignored, but not Laravel's placeholder .gitignore
# files, which an app commits so the directories exist on a fresh clone.
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/storage/framework/**
!/storage/framework/**/
!/storage/framework/**/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
